{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fall-forward-labs.local/schemas/decision/v1/bridge_request.schema.json",
  "title": "BridgeRequest",
  "type": "object",
  "required": [
    "v",
    "id",
    "op"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "op": {
      "enum": [
        "next_decision_request",
        "submit_order_intent",
        "no_trade",
        "status",
        "hello",
        "report_execution",
        "shutdown"
      ]
    },
    "intent": {
      "$ref": "order_intent.schema.json"
    },
    "execution": {
      "$ref": "order_execution.schema.json"
    },
    "request_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "const": "submit_order_intent"
          }
        }
      },
      "then": {
        "required": [
          "intent"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "no_trade"
          }
        }
      },
      "then": {
        "required": [
          "request_id",
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "report_execution"
          }
        }
      },
      "then": {
        "required": [
          "execution"
        ]
      }
    }
  ]
}
