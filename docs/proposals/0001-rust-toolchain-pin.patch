-# Floating: "stable" resolves to whatever stable Rust is current when rustup installs it, so CI,
-# the devcontainer and laptops can build with different compilers (verified locally on Homebrew
-# rustc 1.97.1, which has no rustup and ignores this file). ADR-0004 (Proposed) pins 1.98.1; that
-# change is prepared, not applied, in docs/proposals/0001-rust-toolchain-pin.patch.
+# Pinned exactly per ADR-0004; moving the pin is its own PR. rustup (CI's `rustup toolchain
+# install`, and the devcontainer's rustup when cargo runs under engine/) installs this version;
+# a rustc without rustup, such as Homebrew's, ignores this file.
 [toolchain]
-channel = "stable"
+channel = "1.98.1"
 components = ["rustfmt", "clippy"]
